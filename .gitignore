# Secrets / local environment (never tracked)
.env
.env.*
!.env.example
.venv/

# Python bytecode / caches
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Rust build output
**/target/
Cargo.lock.bak

# Insta pending snapshots are transient; committed goldens in
# tests/snapshots/*.snap are tracked.
*.snap.new
*.pending-snap

# Experiment raw layer (on disk only; see experiments/README.md)
experiments/**/cells/
experiments/**/*.stdout.txt
experiments/**/*.stderr.txt
experiments/**/exit.txt
experiments/**/wall_ms.txt
experiments/**/proj/
experiments/**/env.json
# Experiments: everything is local-only except the frozen protocol, the
# deviations log, and the Stage-0 command list/template.
experiments/**
!experiments/README.md
!experiments/PROTOCOL.md
!experiments/protocol.json
!experiments/DEVIATIONS.md
!experiments/stage0/
!experiments/stage0/COMMANDS.md
!experiments/stage0/budget.template.json

# Global budget ledger and model-probe output
experiments/budget.json
experiments/probe-*/
experiments/**/cache/
experiments/**/evidence/
experiments/**/raw/
experiments/**/audit.jsonl

# Generic transient logs
*.log

# OS / editor
.DS_Store
.cursor
.agents

# Local lockbud checkout (scripts/setup_lockbud.sh)
tools/lockbud/

# Coordinator task-sheet drafts (local only, never tracked)
docs/prompts/
