{
  "program": "rendezvous_both_send",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "ch"
        ],
        "functions": [
          "main",
          "s1",
          "r"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "ch",
          "kind": "sync",
          "type": "Channel",
          "mode": "Sync",
          "base": "Int",
          "capacity": 0
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::s1",
                "main::r"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "s1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "channel_send",
              "channel": "main::ch",
              "value": "1"
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "r",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "channel_recv",
              "channel": "main::ch",
              "dst": "_"
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
