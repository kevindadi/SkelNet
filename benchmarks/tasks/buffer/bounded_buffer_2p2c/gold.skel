skeleton bounded_buffer_2p2c;

mutex m;
condvar not_full for m;
condvar not_empty for m;
shared count: Int[0..=1] = 0 guarded_by m;

@R1 @R2 @R3 @R5 @R7 @R8 @R9
fn main() { scope { spawn p1(); spawn p2(); spawn c1(); spawn c2(); } }

@R2 @R3 @R5 @R7 @R8 @R9
fn p1() { lock m { while count == 1 { not_full.wait(); } count = count + 1; not_empty.notify_one(); } }

@R2 @R3 @R5 @R7 @R8 @R9
fn p2() { lock m { while count == 1 { not_full.wait(); } count = count + 1; not_empty.notify_one(); } }

@R2 @R4 @R6 @R7 @R8 @R9
fn c1() { lock m { while count == 0 { not_empty.wait(); } count = count - 1; not_full.notify_one(); } }

@R2 @R4 @R6 @R7 @R8 @R9
fn c2() { lock m { while count == 0 { not_empty.wait(); } count = count - 1; not_full.notify_one(); } }
