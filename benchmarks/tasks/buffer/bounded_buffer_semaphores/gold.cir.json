            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "write_shared",
              "resource": "main::count",
              "expr": "count - 1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "semaphore_release",
              "resource": "main::slots"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        }
      ]
    }
