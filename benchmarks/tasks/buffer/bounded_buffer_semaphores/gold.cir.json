              "expr": "count + 1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "semaphore_release",
              "resource": "main::items"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "p2",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "semaphore_acquire",
              "resource": "main::slots"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "write_shared",
              "resource": "main::count",
              "expr": "count + 1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "semaphore_release",
              "resource": "main::items"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "c1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "semaphore_acquire",
              "resource": "main::items"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "write_shared",
              "resource": "main::count",
              "expr": "count - 1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "semaphore_release",
              "resource": "main::slots"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
