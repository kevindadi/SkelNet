skeleton two_cycles;

mutex a;
mutex b;
mutex c;
mutex d;

@R5 @R6 @R7 @R8 @R9 @R11 @R1 @R10 @R2 @R3 @R4
fn main() { scope { spawn t1(); spawn t2(); spawn t3(); spawn t4(); } }

@R5 @R6 @R7 @R8 @R9 @R11
fn t1() { lock a { lock b { } } }

@R5 @R6 @R7 @R8 @R9 @R11
fn t2() { lock a { lock b { } } }

@R5 @R6 @R7 @R8 @R9 @R11
fn t3() { lock c { lock d { } } }

@R5 @R6 @R7 @R8 @R9 @R11
fn t4() { lock c { lock d { } } }
