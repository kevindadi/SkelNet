skeleton cross_module_cycle;

module main {
    mutex a;

    @R5 @R6 @R8 @R9 @R2 @R7 @R1 @R3 @R4
    fn main() { scope { spawn t1(); spawn other::t2(); } }

    @R5 @R6 @R8 @R9
    fn t1() { lock a { lock other::b { } } }
}

module other {
    mutex b;

    @R5 @R6 @R8 @R9
    fn t2() { lock main::a { lock b { } } }
}
