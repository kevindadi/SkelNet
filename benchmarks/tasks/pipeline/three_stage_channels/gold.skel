skeleton three_stage_channels;

mutex m;
channel ch1: Int cap 1;
channel ch2: Int cap 1;
shared processed: Int = 0 guarded_by m;

@R1 @R2 @R7
fn main() { scope { spawn stage1(); spawn stage2(); spawn stage3(); } }

@R2 @R3 @R8
fn stage1() { ch1.send(1); ch1.send(2); ch1.send(3); lock m { processed = processed + 1; } }

@R2 @R4 @R5 @R8
fn stage2() { ch1.recv(); ch1.recv(); ch1.recv(); ch2.send(2); ch2.send(3); ch2.send(4); lock m { processed = processed + 1; } }

@R2 @R6 @R8
fn stage3() { ch2.recv(); ch2.recv(); ch2.recv(); lock m { processed = processed + 1; } }
