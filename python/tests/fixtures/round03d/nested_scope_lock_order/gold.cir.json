{
  "program": "nested_scope",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "a",
          "b"
        ],
        "functions": [
          "main",
          "outer",
          "x1",
          "x2"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "a",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "b",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::outer"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "outer",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::x1",
                "main::x2"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "x1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::a"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::b"
            },
            {
              "sid": "s3",
              "kind": "mutex_unlock",
              "resource": "main::b"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::a"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        },
        {
          "name": "x2",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::a"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::b"
            },
            {
              "sid": "s3",
              "kind": "mutex_unlock",
              "resource": "main::b"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::a"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
